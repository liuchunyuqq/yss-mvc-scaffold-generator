{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "policy_digest", "types"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "yss.mvc.package-layout"},
    "policy_version": {"type": "integer", "minimum": 1},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "types": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "module", "feature", "role", "package", "path", "rule_id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
        "module": {"enum": ["server", "core", "client", "repository", "adapter", "feign-client"]},
        "feature": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "pattern": "^mvc\\.layout\\.[a-z-]+$"}
      }
    }}
  }
}
